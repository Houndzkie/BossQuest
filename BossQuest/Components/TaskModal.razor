@inject GameState Game

<div class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700/80 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
        <!-- Modal Title -->
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
                <span>@(isEditing ? "✏️ Edit Quest" : "⚔️ Add New Quest")</span>
            </h3>
            <button @onclick="() => OnCancel.InvokeAsync()" class="text-slate-400 hover:text-white text-lg">
                ✕
            </button>
        </div>

        <!-- Title -->
        <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">
                Task Title *
            </label>
            <input id="edittextTaskTitle"
                   type="text"
                   @bind="model.Title"
                   placeholder="e.g. Finish Automata Problem Set"
                   class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500/50" />
        </div>

        <!-- Description -->
        <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">
                Description / Checklist
            </label>
            <textarea id="edittextTaskDescription"
                      @bind="model.Description"
                      rows="2"
                      placeholder="e.g. Problems 1-15 on regex conversion"
                      class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500/50"></textarea>
        </div>

        <!-- Task Type Toggle -->
        <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">
                Category
            </label>
            <div class="grid grid-cols-2 gap-2">
                <button id="buttonTypeDaily"
                        type="button"
                        @onclick="() => model.TaskType = TaskType.Daily"
                        class="py-2 rounded-xl text-xs font-semibold border transition flex items-center justify-center gap-1.5 @(model.TaskType == TaskType.Daily ? "bg-purple-600 text-white border-purple-500 shadow-md shadow-purple-600/30" : "bg-slate-800 text-slate-400 border-slate-700")">
                    <span>📋</span> Daily Habit
                </button>
                <button id="buttonTypeQuest"
                        type="button"
                        @onclick="() => model.TaskType = TaskType.Quest"
                        class="py-2 rounded-xl text-xs font-semibold border transition flex items-center justify-center gap-1.5 @(model.TaskType == TaskType.Quest ? "bg-purple-600 text-white border-purple-500 shadow-md shadow-purple-600/30" : "bg-slate-800 text-slate-400 border-slate-700")">
                    <span>📜</span> Assignment Quest
                </button>
            </div>
        </div>

        <!-- Difficulty Selection -->
        <div>
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">
                Difficulty Tier & Boss Damage
            </label>
            <div class="grid grid-cols-4 gap-1.5">
                <button id="buttonDiffEasy"
                        type="button"
                        @onclick="() => model.Difficulty = Difficulty.Easy"
                        class="py-1.5 rounded-lg text-xs font-bold border transition text-center @(model.Difficulty == Difficulty.Easy ? "bg-emerald-600 text-white border-emerald-500 shadow-md shadow-emerald-600/20" : "bg-slate-800 text-emerald-400 border-slate-700 hover:bg-slate-700")">
                    Easy<br/><span class="text-[10px] font-normal">10 DMG</span>
                </button>
                <button id="buttonDiffMedium"
                        type="button"
                        @onclick="() => model.Difficulty = Difficulty.Medium"
                        class="py-1.5 rounded-lg text-xs font-bold border transition text-center @(model.Difficulty == Difficulty.Medium ? "bg-amber-600 text-white border-amber-500 shadow-md shadow-amber-600/20" : "bg-slate-800 text-amber-400 border-slate-700 hover:bg-slate-700")">
                    Medium<br/><span class="text-[10px] font-normal">20 DMG</span>
                </button>
                <button id="buttonDiffHard"
                        type="button"
                        @onclick="() => model.Difficulty = Difficulty.Hard"
                        class="py-1.5 rounded-lg text-xs font-bold border transition text-center @(model.Difficulty == Difficulty.Hard ? "bg-orange-600 text-white border-orange-500 shadow-md shadow-orange-600/20" : "bg-slate-800 text-orange-400 border-slate-700 hover:bg-slate-700")">
                    Hard<br/><span class="text-[10px] font-normal">35 DMG</span>
                </button>
                <button id="buttonDiffExam"
                        type="button"
                        @onclick="() => model.Difficulty = Difficulty.Exam"
                        class="py-1.5 rounded-lg text-xs font-bold border transition text-center @(model.Difficulty == Difficulty.Exam ? "bg-red-600 text-white border-red-500 shadow-md shadow-red-600/20" : "bg-slate-800 text-red-400 border-slate-700 hover:bg-slate-700")">
                    Exam<br/><span class="text-[10px] font-normal">50 DMG</span>
                </button>
            </div>
        </div>

        <!-- Course Label & Due Date -->
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">
                    Course Code
                </label>
                <input id="edittextCourseLabel"
                       type="text"
                       @bind="model.CourseLabel"
                       placeholder="e.g. CS 301"
                       class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500/50" />
            </div>

            @if (model.TaskType == TaskType.Quest)
            {
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">
                        Due Date
                    </label>
                    <input id="inputDueDate"
                           type="date"
                           value="@dueDateString"
                           @onchange="HandleDateChange"
                           class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-purple-500/50" />
                </div>
            }
        </div>

        <!-- Footer Buttons -->
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-800">
            <button id="buttonCancelTask"
                    type="button"
                    @onclick="() => OnCancel.InvokeAsync()"
                    class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-xl border border-slate-700 transition">
                Cancel
            </button>
            <button id="buttonSaveTask"
                    type="button"
                    @onclick="Save"
                    disabled="@string.IsNullOrWhiteSpace(model.Title)"
                    class="px-5 py-2 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 disabled:opacity-40 text-white text-xs font-bold rounded-xl shadow-lg shadow-purple-600/30 transition">
                Save Quest
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public TaskItem? EditTask { get; set; }
    [Parameter] public EventCallback<TaskItem> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private TaskItem model = new();
    private bool isEditing = false;
    private string dueDateString = "";

    protected override void OnInitialized()
    {
        if (EditTask != null && EditTask.Id != Guid.Empty && !string.IsNullOrWhiteSpace(EditTask.Title))
        {
            isEditing = true;
            model = new TaskItem
            {
                Id = EditTask.Id,
                UserId = EditTask.UserId,
                Title = EditTask.Title,
                Description = EditTask.Description,
                TaskType = EditTask.TaskType,
                Difficulty = EditTask.Difficulty,
                CourseLabel = EditTask.CourseLabel,
                DueDate = EditTask.DueDate,
                IsCompleted = EditTask.IsCompleted,
                CreatedAt = EditTask.CreatedAt
            };
        }
        else if (EditTask != null)
        {
            model.TaskType = EditTask.TaskType;
        }

        if (model.DueDate.HasValue)
        {
            dueDateString = model.DueDate.Value.ToString("yyyy-MM-dd");
        }
    }

    private void HandleDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            model.DueDate = dt;
        }
        else
        {
            model.DueDate = null;
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(model.Title)) return;
        await OnSave.InvokeAsync(model);
    }
}
