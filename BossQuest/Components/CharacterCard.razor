@inject GameState Game

<div class="bg-slate-900/90 rounded-2xl border border-slate-700/80 p-5 shadow-xl backdrop-blur-sm">
    <!-- Header: Avatar, Name, Level & Class -->
    <div class="flex items-center gap-4 mb-4">
        <div class="relative">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-slate-800 to-slate-700 border-2 border-purple-500/50 flex items-center justify-center text-3xl shadow-inner">
                @Game.CurrentUser.ClassIcon
            </div>
            <div class="absolute -bottom-1 -right-1 bg-purple-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full border border-slate-900">
                Lv.@Game.CurrentUser.Level
            </div>
        </div>

        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
                <h2 class="text-lg font-bold text-white truncate">@Game.CurrentUser.Username</h2>
            </div>
            <div class="flex items-center gap-2 mt-0.5">
                <span class="text-xs px-2.5 py-0.5 rounded-full font-semibold border @Game.CurrentUser.ClassBadgeColor">
                    @Game.CurrentUser.Class (@Game.CurrentUser.ClassRoleTitle)
                </span>
            </div>
        </div>
    </div>

    <!-- Stat Bars -->
    <div class="space-y-3">
        <!-- HP Bar -->
        <div>
            <div class="flex justify-between items-center text-xs mb-1">
                <span class="font-semibold text-rose-400 flex items-center gap-1">
                    <span>❤️</span> HP
                </span>
                <span id="textviewHp" class="font-mono text-slate-300">
                    @Game.CurrentUser.Hp / @Game.CurrentUser.MaxHp
                </span>
            </div>
            <div class="h-3.5 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700/60 shadow-inner">
                <div class="h-full rounded-full bg-gradient-to-r from-red-600 via-rose-500 to-pink-500 transition-all duration-500"
                     style="width: @(Game.CurrentUser.HpPercent)%">
                </div>
            </div>
        </div>

        <!-- MP Bar -->
        <div>
            <div class="flex justify-between items-center text-xs mb-1">
                <span class="font-semibold text-indigo-400 flex items-center gap-1">
                    <span>💧</span> MP
                </span>
                <span id="textviewMp" class="font-mono text-slate-300">
                    @Game.CurrentUser.Mp / @Game.CurrentUser.MaxMp
                </span>
            </div>
            <div class="h-3.5 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700/60 shadow-inner">
                <div class="h-full rounded-full bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400 transition-all duration-500"
                     style="width: @(Game.CurrentUser.MpPercent)%">
                </div>
            </div>
        </div>

        <!-- XP Bar -->
        <div>
            <div class="flex justify-between items-center text-xs mb-1">
                <span class="font-semibold text-amber-400 flex items-center gap-1">
                    <span>✨</span> XP
                </span>
                <span id="textviewXp" class="font-mono text-slate-300">
                    @Game.CurrentUser.Xp / @Game.CurrentUser.XpToNext
                </span>
            </div>
            <div class="h-3 bg-slate-800 rounded-full overflow-hidden p-0.5 border border-slate-700/60 shadow-inner">
                <div class="h-full rounded-full bg-gradient-to-r from-amber-500 to-yellow-400 transition-all duration-500"
                     style="width: @(Game.CurrentUser.XpPercent)%">
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Grid: Gold, ATK, Streak -->
    <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-slate-800">
        <div class="bg-slate-800/60 rounded-xl p-2.5 text-center border border-slate-700/40">
            <div class="text-xs text-slate-400 mb-0.5 flex items-center justify-center gap-1">
                <span>💰</span> Gold
            </div>
            <div id="textviewGold" class="font-bold text-amber-400 font-mono text-base">
                @Game.CurrentUser.Gold
            </div>
        </div>

        <div class="bg-slate-800/60 rounded-xl p-2.5 text-center border border-slate-700/40">
            <div class="text-xs text-slate-400 mb-0.5 flex items-center justify-center gap-1">
                <span>⚔️</span> ATK
            </div>
            <div class="font-bold text-orange-400 font-mono text-base">
                @Game.CurrentUser.Attack
            </div>
        </div>

        <div class="bg-slate-800/60 rounded-xl p-2.5 text-center border border-slate-700/40">
            <div class="text-xs text-slate-400 mb-0.5 flex items-center justify-center gap-1">
                <span>🔥</span> Streak
            </div>
            <div class="font-bold text-rose-400 font-mono text-base">
                @Game.CurrentUser.StreakDays d
            </div>
        </div>
    </div>

    <!-- Active Class Skills -->
    <div class="mt-4 pt-4 border-t border-slate-800">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1">
                <span>⚡</span> Class Skills
            </span>
            @if (Game.HasArcaneFocusBuff)
            {
                <span class="text-[10px] bg-blue-500/20 text-blue-300 border border-blue-500/40 px-2 py-0.5 rounded-full font-semibold animate-pulse">
                    2x XP Ready
                </span>
            }
        </div>

        <div class="space-y-2">
            @if (Game.CurrentUser.Class == "Warrior")
            {
                <button id="buttonSkillPowerStrike"
                        @onclick='() => Game.UseSkill("Power Strike")'
                        disabled="@(Game.CurrentUser.Mp < 10)"
                        class="w-full text-left p-2.5 rounded-xl border border-red-500/30 bg-red-950/20 hover:bg-red-900/30 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center justify-between group">
                    <div>
                        <div class="text-xs font-bold text-red-300 group-hover:text-red-200">⚔️ Power Strike</div>
                        <div class="text-[11px] text-slate-400">Deals 1.5x ATK (@((int)(Game.CurrentUser.Attack * 1.5)) DMG) immediately</div>
                    </div>
                    <span class="text-xs font-mono font-bold text-indigo-400 bg-indigo-950/60 px-2 py-1 rounded-md border border-indigo-500/30">
                        10 MP
                    </span>
                </button>
            }
            else if (Game.CurrentUser.Class == "Mage")
            {
                <button id="buttonSkillArcaneFocus"
                        @onclick='() => Game.UseSkill("Arcane Focus")'
                        disabled="@(Game.CurrentUser.Mp < 15 || Game.HasArcaneFocusBuff)"
                        class="w-full text-left p-2.5 rounded-xl border border-blue-500/30 bg-blue-950/20 hover:bg-blue-900/30 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center justify-between group">
                    <div>
                        <div class="text-xs font-bold text-blue-300 group-hover:text-blue-200">🔮 Arcane Focus</div>
                        <div class="text-[11px] text-slate-400">Doubles XP awarded from next Pomodoro Focus session</div>
                    </div>
                    <span class="text-xs font-mono font-bold text-indigo-400 bg-indigo-950/60 px-2 py-1 rounded-md border border-indigo-500/30">
                        15 MP
                    </span>
                </button>
            }
            else if (Game.CurrentUser.Class == "Healer")
            {
                <button id="buttonSkillHealingLight"
                        @onclick='() => Game.UseSkill("Healing Light")'
                        disabled="@(Game.CurrentUser.Mp < 20)"
                        class="w-full text-left p-2.5 rounded-xl border border-emerald-500/30 bg-emerald-950/20 hover:bg-emerald-900/30 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center justify-between group">
                    <div>
                        <div class="text-xs font-bold text-emerald-300 group-hover:text-emerald-200">💚 Healing Light</div>
                        <div class="text-[11px] text-slate-400">Restores 20 HP to the lowest health party member</div>
                    </div>
                    <span class="text-xs font-mono font-bold text-indigo-400 bg-indigo-950/60 px-2 py-1 rounded-md border border-indigo-500/30">
                        20 MP
                    </span>
                </button>
            }
            else if (Game.CurrentUser.Class == "Rogue")
            {
                <button id="buttonSkillGoldRush"
                        @onclick='() => Game.UseSkill("Gold Rush")'
                        disabled="@(Game.CurrentUser.Mp < 10)"
                        class="w-full text-left p-2.5 rounded-xl border border-amber-500/30 bg-amber-950/20 hover:bg-amber-900/30 disabled:opacity-40 disabled:cursor-not-allowed transition flex items-center justify-between group">
                    <div>
                        <div class="text-xs font-bold text-amber-300 group-hover:text-amber-200">💰 Gold Rush</div>
                        <div class="text-[11px] text-slate-400">Instantly scavenge 35 bonus Gold for the Armory</div>
                    </div>
                    <span class="text-xs font-mono font-bold text-indigo-400 bg-indigo-950/60 px-2 py-1 rounded-md border border-indigo-500/30">
                        10 MP
                    </span>
                </button>
            }
        </div>
    </div>
</div>
